{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config scripts/wrangler.local.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:reviews": "node scripts/test-reviews.mjs",
    "test:reviews:cleanup": "node scripts/cleanup-review-tests.mjs",
    "dev:api": "wrangler dev --config backend/wrangler.local.json --local --persist-to .wrangler/state --port 8787 --inspector-port 9231",
    "build:api": "wrangler deploy --config backend/wrangler.local.json --dry-run --outdir dist/api",
    "deploy:api": "node scripts/deploy-api.mjs",
    "test:cors": "node scripts/test-cors.mjs",
    "test:upload": "node --experimental-strip-types scripts/test-upload.mjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@rolldown/binding-wasm32-wasi": "^1.0.1",
    "@tailwindcss/oxide-wasm32-wasi": "^4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "lightningcss-wasm": "^1.31.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
