{
  "name": "saar-bites-api",
  "main": "worker.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://namingisnothard.github.io" },
  "d1_databases": [{ "binding": "DB", "database_name": "saar-bites-reviews", "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID", "migrations_dir": "../drizzle" }],
  "r2_buckets": [{ "binding": "REVIEW_PHOTOS", "bucket_name": "saar-bites-review-photos" }]
}
